@@ -0,0 +1,44 @@
+//go:build ohos
+
+package anet
+
+import (
+	"net"
+	"sync"
+)
+
+var (
+	injectedMu   sync.RWMutex
+	injectedIfas []net.Interface
+)
+
+// SetNetInterfaces 由宿主(HarmonyOS 应用侧)注入网络接口信息。
+// OHOS 沙箱内 net.Interfaces() 可能无法获取完整信息(如 MAC 地址)，
+// 由应用侧通过系统 API 读取后注入；未注入时回退到系统调用。
+func SetNetInterfaces(ifas []net.Interface) {
+	injectedMu.Lock()
+	defer injectedMu.Unlock()
+	injectedIfas = ifas
+}
+
+// Interfaces returns a list of the system's network interfaces.
+func Interfaces() ([]net.Interface, error) {
+	injectedMu.RLock()
+	defer injectedMu.RUnlock()
+	if len(injectedIfas) > 0 {
+		return injectedIfas, nil
+	}
+	return net.Interfaces()
+}
+
+// InterfaceAddrs returns a list of the system's unicast interface
+// addresses.
+func InterfaceAddrs() ([]net.Addr, error) {
+	return net.InterfaceAddrs()
+}
+
+// InterfaceAddrsByInterface returns a list of the system's unicast
+// interface addresses by specific interface.
+func InterfaceAddrsByInterface(ifi *net.Interface) ([]net.Addr, error) {
+	return ifi.Addrs()
+}
