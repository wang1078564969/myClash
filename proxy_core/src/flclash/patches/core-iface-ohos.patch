@@ -0,0 +1,16 @@
+//go:build ohos
+
+package iface
+
+import (
+	"net"
+
+	"github.com/metacubex/mihomo/component/iface/anet"
+)
+
+// SetNetInterfaces 保持与旧内核(ClashBox fork)一致的接口注入 API：
+// 应用侧从 HarmonyOS 系统 API 读取接口信息后注入内核。
+// 实际存储在 anet 包(见 anet/interface_ohos.go)。
+func SetNetInterfaces(interfaces []net.Interface) {
+	anet.SetNetInterfaces(interfaces)
+}
